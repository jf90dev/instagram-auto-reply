    "localstack:setup": {
      "name": "localstack:setup",
      "description": "Deploys the LocalStack stand-ins for external resources",
      "env": {
        "AWS_ACCESS_KEY_ID": "test",
        "AWS_SECRET_ACCESS_KEY": "test",
        "AWS_DEFAULT_REGION": "eu-west-1"
      },
      "steps": [
        {
          "exec": "cdklocal deploy -a \"npx tsx src/local/set-up-main.ts\" --require-approval never"
        },
        {
          "exec": "aws ssm put-parameter --endpoint-url http://localhost:4566 --name /Local/InstagramAutoReply/Instagram/AppSecret --type SecureString --value local-app-secret --overwrite"
        },
        {
          "exec": "aws ssm put-parameter --endpoint-url http://localhost:4566 --name /Local/InstagramAutoReply/Instagram/VerifyToken --type SecureString --value local-verify-token --overwrite"
        },
        {
          "exec": "aws ssm put-parameter --endpoint-url http://localhost:4566 --name /Local/InstagramAutoReply/Instagram/AccessToken --type SecureString --value local-access-token --overwrite"
        },
        {
          "exec": "aws ssm put-parameter --endpoint-url http://localhost:4566 --name /Local/InstagramAutoReply/Instagram/UserId --type String --value 17840000000000000 --overwrite"
        },
        {
          "exec": "aws ssm put-parameter --endpoint-url http://localhost:4566 --name /Local/InstagramAutoReply/Anthropic/ApiKey --type SecureString --value local-anthropic-api-key --overwrite"
        },
        {
          "exec": "aws ssm put-parameter --endpoint-url http://localhost:4566 --name /Local/InstagramAutoReply/MongoDb/Uri --type SecureString --value mongodb://mongodb:27017 --overwrite"
        }
      ]
