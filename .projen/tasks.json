    "localstack:bootstrap": {
      "name": "localstack:bootstrap",
      "description": "Bootstraps CDK in LocalStack and grants the bootstrap roles admin (LocalStack enforces IAM)",
      "env": {
        "AWS_ACCESS_KEY_ID": "test",
        "AWS_SECRET_ACCESS_KEY": "test",
        "AWS_DEFAULT_REGION": "eu-west-1"
      },
      "steps": [
        {
          "exec": "cdklocal bootstrap aws://000000000000/eu-west-1"
        },
        {
          "exec": "aws iam attach-role-policy --endpoint-url http://localhost:4566 --role-name cdk-hnb659fds-deploy-role-000000000000-eu-west-1 --policy-arn arn:aws:iam::aws:policy/AdministratorAccess"
        },
        {
          "exec": "aws iam attach-role-policy --endpoint-url http://localhost:4566 --role-name cdk-hnb659fds-file-publishing-role-000000000000-eu-west-1 --policy-arn arn:aws:iam::aws:policy/AdministratorAccess"
        },
        {
          "exec": "aws iam attach-role-policy --endpoint-url http://localhost:4566 --role-name cdk-hnb659fds-image-publishing-role-000000000000-eu-west-1 --policy-arn arn:aws:iam::aws:policy/AdministratorAccess"
        },
        {
          "exec": "aws iam attach-role-policy --endpoint-url http://localhost:4566 --role-name cdk-hnb659fds-lookup-role-000000000000-eu-west-1 --policy-arn arn:aws:iam::aws:policy/AdministratorAccess"
        },
        {
          "exec": "aws iam attach-role-policy --endpoint-url http://localhost:4566 --role-name cdk-hnb659fds-cfn-exec-role-000000000000-eu-west-1 --policy-arn arn:aws:iam::aws:policy/AdministratorAccess"
        }
      ]
    },
