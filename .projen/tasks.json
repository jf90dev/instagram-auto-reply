        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "test",
            "build-tools",
            "projenrc",
            ".projenrc.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
