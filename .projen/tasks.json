      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "src/lambda/generate-reply/generate-reply.lambda.ts",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/lambda/generate-reply/generate-reply.lambda/index.js",
            "--packages=bundle",
            "--tsconfig=test/tsconfig.json",
            "--external:@aws-sdk/*",
            "--sourcemap"
          ]
        }
      ]
    },
